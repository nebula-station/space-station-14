                         HorizontalExpand="True"
                         VerticalExpand="True">
            <BoxContainer Name="RoomsContainer"
                          Orientation="Vertical"
                          HorizontalExpand="True"
                          Margin="6"/>
        </ScrollContainer>
    </PanelContainer>
</controls:FancyWindow>
