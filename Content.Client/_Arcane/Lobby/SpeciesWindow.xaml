<nc:NebulaWindow xmlns="https://spacestation14.io"
                 xmlns:nc="clr-namespace:Content.Client._Nebula.UserInterface.Controls"
                 xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 x:Class="Content.Client._Arcane.Lobby.SpeciesWindow"
                 Title="{Loc species-window-title}"
                 SetSize="860 680"
                 MinSize="680 480">
    <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True">
        <nc:ShapedPanel StyleClasses="NebulaSection" MinWidth="220" VerticalExpand="True">
            <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="SpeciesContainer"
                              Orientation="Vertical"
                              SeparationOverride="4"
                              HorizontalExpand="True"
                              Margin="8"/>
            </ScrollContainer>
        </nc:ShapedPanel>
        <BoxContainer Orientation="Vertical" SeparationOverride="8" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalAlignment="Center">
                <nc:ShapedPanel StyleClasses="NebulaCard" SetSize="200 200">
                    <profile:ProfilePreviewSpriteView Name="Mob" Scale="4 4"/>
                </nc:ShapedPanel>
                <nc:ShapedPanel StyleClasses="NebulaCard" SetSize="200 200">
                    <profile:ProfilePreviewSpriteView Name="JobLoadout" Scale="4 4"/>
                </nc:ShapedPanel>
            </BoxContainer>
            <nc:ShapedButton Name="Select"
                             StyleClasses="NebulaButtonFilled"
                             HorizontalAlignment="Center"
                             MinWidth="408"
                             Text="{Loc species-window-select-button}"/>
            <nc:ShapedPanel StyleClasses="NebulaSection" VerticalExpand="True">
                <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Name="DetailInfoContainer"
                                  Orientation="Vertical"
                                  HorizontalExpand="True"
                                  Margin="8"/>
                </ScrollContainer>
            </nc:ShapedPanel>
        </BoxContainer>
    </BoxContainer>
</nc:NebulaWindow>
