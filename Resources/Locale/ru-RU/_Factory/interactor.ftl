interactor-verb-toggled-drop-locked = { $enabled ->
    [true] Заблокировано
    *[false] Разблокировано
} выбрасывание предметов из рук.
interactor-verb-toggled-pickup-locked = { $enabled ->
    [true] Заблокировано
    *[false] Разблокировано
} подбирание предметов.
interactor-verb-toggle-drop-locked = Переключить блокировку выбрасывания
interactor-verb-toggle-pickup-locked = Переключить блокировку подбирания
