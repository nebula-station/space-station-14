uniform sampler2D displacementMap;
uniform highp float displacementSize;
uniform highp vec4 displacementUV;
uniform highp float displacementScale;

varying highp vec2 displacementCoord;

void vertex() {
    displacementCoord = (tCoord2 - vec2(0.5)) * displacementScale + vec2(0.5);
}

void fragment() {
    // Nebula edit
    if (displacementCoord.x < 0.0 || displacementCoord.x > 1.0 || displacementCoord.y < 0.0 || displacementCoord.y > 1.0) {
        COLOR = zTexture(UV);
    } else {
        highp vec4 displacementSample = texture2D(displacementMap, mix(displacementUV.xy, displacementUV.zw, displacementCoord));
        highp vec2 displacementValue = (displacementSample.xy - vec2(128.0 / 255.0)) / (1.0 - 128.0 / 255.0);
        COLOR = zTexture(UV + displacementValue * TEXTURE_PIXEL_SIZE * displacementSize * vec2(1.0, -1.0));
        COLOR.a *= displacementSample.a;
    }
}
