light_mode unshaded;

uniform highp vec3 color1;
uniform highp vec3 color2;
uniform highp float alpha;
uniform highp float intensity;
uniform highp float texHeight;
uniform highp float t;
uniform highp float interference;

const highp float PI = 3.14159265;

void fragment() {
	highp float frame = floor(t * 96.0);
	highp float band = floor(UV.y * texHeight * 0.25);
	highp float tearNoise = fract(sin(band * 12.9898 + frame * 78.233) * 43758.5453);
	highp float tear = (tearNoise - 0.5) * 0.25 * interference * interference;
	highp float flicker = 1.0 - interference * 0.6 * fract(sin(frame * 91.7) * 43758.5453);

	highp vec4 base = texture2D(TEXTURE, UV + vec2(tear, 0.0));
	highp float bw = zGrayscale(base.rgb * intensity);
	highp vec4 color = vec4(vec3(color1), alpha);

	if (sin(PI * (UV.y + t) * texHeight) < 0.0)
	{
		color = vec4(vec3(color2), alpha);
	}

	color.a *= (1.0 - interference) * flicker;

	COLOR = vec4(vec3(bw), base.a) * color;
}
